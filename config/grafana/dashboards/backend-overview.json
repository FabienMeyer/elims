      "targets": [{"expr": "sum(rate(http_requests_total[5m]))", "legendFormat": "requests"}],
      "title": "Backend request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
