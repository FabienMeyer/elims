{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "ba79c09a5abae12d0317fea771e5776a31f02867",
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "elims",
      "package-name": "elims",
      "pull-request-title-pattern": "chore(release): release ${version}",
      "extra-files": [
        {
          "type": "toml",
          "path": "backend/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "json",
          "path": "frontend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "frontend/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "frontend/package-lock.json",
          "jsonpath": "$.packages[''].version"
        },
        {
          "type": "toml",
          "path": "packages/elims-cli/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/elims-com/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/elims-database/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/elims-instruments/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/elims-utils/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        "packages/elims-cli/src/elims_cli/__init__.py",
        "packages/elims-com/src/elims_com/__init__.py",
        "packages/elims-database/src/elims_database/__init__.py",
        "packages/elims-instruments/src/elims_instruments/__init__.py",
        "packages/elims-utils/src/elims_utils/__init__.py"
      ]
    }
  }
}
