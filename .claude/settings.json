{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"$CLAUDE_PROJECT_DIR/.claude/skills/shared/hooks/guard_gated_mutations.py\"",
            "shell": "bash",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Checking ELIMS delivery gates"
          }
        ]
      }
    ]
  }
}
